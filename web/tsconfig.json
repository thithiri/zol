{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "preserveSymlinks": false,
    "allowImportingTsExtensions": false
  },
  "include": [
    "src",
    "test",
    "house",
    "vite.config.ts"
  ],
  "exclude": [
    "house/server.ts"
  ]
}
