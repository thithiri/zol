# The testnet beta's /etc/caddy/Caddyfile (root:caddy 0640), as on the host. It holds no secret:
# /solana goes to the house, which keeps the RPC key in house.json (`solanaUpstream`).

# Every site serves the same routes.
(zol) {
	encode gzip
	# `route` keeps this order: operator traffic (/peer/*) is never proxied.
	route {
		@peer path */peer/*
		respond @peer 404
		handle_path /op0/* {
			reverse_proxy 127.0.0.1:8700
		}
		handle_path /op1/* {
			reverse_proxy 127.0.0.1:8701
		}
		handle_path /op2/* {
			reverse_proxy 127.0.0.1:8702
		}
		# The pages' Solana RPC: the house filters it (allowed methods, a rate per address) and
		# passes it to a dedicated RPC whose key stays in its config.
		handle /solana {
			reverse_proxy 127.0.0.1:8790
		}
		# The house service (single-player games); keeps its /house prefix.
		handle /house/* {
			reverse_proxy 127.0.0.1:8790
		}
		# Pages are rechecked on every visit; built assets have hashed names and never change.
		@html path / *.html */
		header @html Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		root * /var/www/zol
		file_server
	}
}

zol.cash {
	import zol
}

www.zol.cash {
	redir https://zol.cash{uri} 308
}

# The first address: pages move to zol.cash; the APIs keep answering here.
159-223-38-126.sslip.io {
	@pages not path /op0/* /op1/* /op2/* /solana /house/*
	redir @pages https://zol.cash{uri} 308
	import zol
}
